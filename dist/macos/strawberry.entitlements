<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- GStreamer's orc library JIT-compiles SIMD codegen at runtime, which needs writable and executable memory that the Hardened Runtime otherwise blocks. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>

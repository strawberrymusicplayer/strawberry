<#
.SYNOPSIS
  Creates the StrawberrySetup installer with the Qt Installer Framework
.DESCRIPTION
  Run from the directory with the files to install, the same directory as used for creating the NSIS installer with strawberry.nsi.
  The qtifw directory generated by CMake must be in the same directory.
.PARAMETER binarycreator
  Path to binarycreator.exe from the Qt Installer Framework (default: binarycreator from PATH)
#>

[CmdletBinding()]
param(
  [Parameter(Mandatory=$false)]
  [string]$binarycreator = "binarycreator"
)

$ErrorActionPreference = "Stop"

$setup_file = "@QTIFW_SETUP_FILENAME@"
$package_data_path = "qtifw/packages/org.strawberrymusicplayer.strawberry/data"
$plugin_dirs = @("gio-modules", "platforms", "styles", "tls", "sqldrivers", "imageformats", "gstreamer-plugins")

if (-not (Test-Path "qtifw/config/config.xml")) {
  throw "Missing qtifw/config/config.xml, run from the directory with the files to install."
}

if (Test-Path $package_data_path) {
  Remove-Item $package_data_path -Recurse -Force
}
New-Item -ItemType Directory -Path $package_data_path -Force | Out-Null

# All executables and DLLs, except the installers themselves. The Visual C++ Runtime installer is run and deleted by the install script.
Get-ChildItem -File -Path "*" -Include "*.exe", "*.dll" | Where-Object { $_.Name -notlike "StrawberrySetup*" } | Copy-Item -Destination $package_data_path
Copy-Item "strawberry.ico" $package_data_path
foreach ($plugin_dir in $plugin_dirs) {
  if (Test-Path $plugin_dir) {
    Copy-Item $plugin_dir $package_data_path -Recurse
  }
}

foreach ($i in @("strawberry.exe", "@QTIFW_VC_REDIST@")) {
  if ($i -and -not (Test-Path "$package_data_path/$i")) {
    throw "Missing $i"
  }
}

if (Test-Path $setup_file) {
  Remove-Item $setup_file -Force
}

& $binarycreator --offline-only -c "qtifw/config/config.xml" -p "qtifw/packages" $setup_file
if ($LASTEXITCODE -ne 0) {
  throw "binarycreator failed"
}

Write-Host "Created $setup_file"
